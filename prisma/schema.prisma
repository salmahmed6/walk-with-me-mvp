generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  username   String   @unique
  password   String?
  googleId   String?
  twitterId  String?
  createdAt  DateTime @default(now())

  @@map("users")
}