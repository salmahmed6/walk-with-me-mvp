generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String?
  lastName     String?
  bio          String?
  avatarUrl    String?
  provider     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}